#!/bin/bash

# Install optional sets of packages on top of the base image.
# Without arguments, the profiles to install are asked for interactively.

set -u

declare -rA DESCRIPTIONS=(
	[developer]="Build tools, git, GitHub CLI, editors and man pages"
	[docker]="Docker Engine with Compose and Buildx, adds you to the docker group (skip it if you use Docker Desktop)"
	[podman]="Rootless Podman with a docker compatible command (skip it if you use Docker Desktop)"
	[ai]="CUDA, cuDNN and PyTorch for the NVIDIA GPU (about 4.6 GiB to download)"
)

# Never add nvidia-utils: WSL provides the NVIDIA driver libraries from Windows in /usr/lib/wsl/lib
declare -rA PACKAGES=(
	[developer]="base-devel git github-cli openssh man-db man-pages nano vim wget unzip"
	[docker]="docker docker-compose docker-buildx"
	[podman]="podman podman-docker"
	[ai]="cuda cudnn python-pytorch-cuda"
)

declare -r AI_UNAVAILABLE="The ai profile needs an NVIDIA GPU with a WSL capable Windows driver (no /usr/lib/wsl/lib/libcuda.so.1)"

# WSL only exposes the CUDA library when the Windows NVIDIA driver supports it.
# AMD GPUs are not supported, the ROCm packages are not built with the WSL (DXG) backend.
has_nvidia_gpu() {
	[ -e /usr/lib/wsl/lib/libcuda.so.1 ]
}

if has_nvidia_gpu; then
	declare -ra PROFILES=(developer docker podman ai)
else
	declare -ra PROFILES=(developer docker podman)
fi

is_selected() {
	[[ " ${selected[*]} " == *" $1 "* ]]
}

# The user getting access to Docker: the one running sudo, or the default user during the first setup
docker_user() {
	if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
		echo "$SUDO_USER"
	else
		getent passwd 1000 | cut -d: -f1
	fi
}

usage() {
	cat <<EOF
Usage: $0 [--noconfirm] [PROFILE...]
       $0 --print PROFILE...
       $0 --list

Install optional sets of packages. Without a profile, they are asked for interactively.
--print only prints the packages of the given profiles.

Profiles:
EOF
	list
}

list() {
	local profile
	for profile in "${PROFILES[@]}"; do
		printf '  %-11s %s\n' "$profile" "${DESCRIPTIONS[$profile]}"
	done
	has_nvidia_gpu || echo "$AI_UNAVAILABLE"
}

is_profile() {
	local profile
	for profile in "${PROFILES[@]}"; do
		[ "$profile" = "$1" ] && return 0
	done
	return 1
}

# Accept both the numbers shown in the menu and the profile names
resolve() {
	local word
	selected=()
	for word in "$@"; do
		if [[ $word =~ ^[0-9]{1,3}$ ]] && ((10#$word >= 1 && 10#$word <= ${#PROFILES[@]})); then
			word=${PROFILES[10#$word - 1]}
		fi
		if [ "$word" = ai ] && ! has_nvidia_gpu; then
			echo "$AI_UNAVAILABLE" >&2
			return 1
		elif ! is_profile "$word"; then
			echo "Unknown profile: $word" >&2
			return 1
		fi
		is_selected "$word" || selected+=("$word")
	done
	if is_selected docker && is_selected podman; then
		echo "The docker and podman profiles both provide the docker command, choose one of them" >&2
		return 1
	fi
}

ask() {
	local i
	local -a answer
	echo "Optional profiles:"
	for i in "${!PROFILES[@]}"; do
		printf '  %d) %-11s %s\n' $((i + 1)) "${PROFILES[i]}" "${DESCRIPTIONS[${PROFILES[i]}]}"
	done
	has_nvidia_gpu || echo "$AI_UNAVAILABLE"
	while true; do
		read -rp 'Enter the numbers or names separated by spaces, or press Enter to skip: ' -a answer || return 1
		resolve "${answer[@]}" && return 0
	done
}

noconfirm=()
print=false
args=()
for arg in "$@"; do
	case "$arg" in
		--noconfirm) noconfirm=(--noconfirm) ;;
		--print) print=true ;;
		--list) list; exit 0 ;;
		-h | --help) usage; exit 0 ;;
		-*) usage >&2; exit 1 ;;
		*) args+=("$arg") ;;
	esac
done

if ((${#args[@]})); then
	resolve "${args[@]}" || exit 1
elif $print; then
	usage >&2
	exit 1
elif [ -t 0 ]; then
	ask || exit 0
else
	usage >&2
	exit 1
fi

if ((${#selected[@]} == 0)); then
	echo "No profile selected"
	exit 0
fi

packages=()
for profile in "${selected[@]}"; do
	read -ra profile_packages <<< "${PACKAGES[$profile]}"
	packages+=("${profile_packages[@]}")
done

if $print; then
	printf '%s\n' "${packages[@]}"
	exit 0
fi

if ((EUID != 0)); then
	echo "This has to be run as root, e.g. \"sudo $0 ${selected[*]}\"" >&2
	exit 1
fi

# Docker Desktop's WSL integration provides its own docker command, which a package can't replace
# (it may be a symlink that dangles while Docker Desktop is stopped)
if { is_selected docker || is_selected podman; } && { [ -e /usr/bin/docker ] || [ -L /usr/bin/docker ]; } &&
	! pacman -Qqo /usr/bin/docker &> /dev/null; then
	echo "/usr/bin/docker doesn't belong to a package (Docker Desktop's WSL integration?), so the docker and podman profiles can't be installed" >&2
	exit 1
fi

echo -e "\nInstalling the ${selected[*]} profile(s)..."
# Upgrade at the same time, partial upgrades are not supported
pacman -Syu --needed "${noconfirm[@]}" "${packages[@]}" || exit 1

if is_selected docker; then
	# Socket activation starts the daemon on first use, so it does not run in the background otherwise
	systemctl enable docker.socket || exit 1
	# The socket can't be started while the service already runs on its own
	if [ -d /run/systemd/system ] && ! systemctl is-active --quiet docker.service; then
		systemctl start docker.socket || exit 1
	fi
	user=$(docker_user)
	if [ -n "$user" ]; then
		usermod --append --groups docker -- "$user" || exit 1
		echo "Added \"$user\" to the docker group, which grants root equivalent access."
		echo "It takes effect after restarting the distribution (\"wsl --terminate <name>\" in PowerShell)."
	fi
fi

if is_selected podman; then
	# Rootless containers need subordinate IDs, which useradd allocates for new users
	while IFS=: read -r name _ uid _; do
		((uid >= 1000 && uid < 60000)) || continue
		for file in /etc/subuid /etc/subgid; do
			# Entries are keyed by user name or UID
			if ! awk -F: -v name="$name" -v uid="$uid" '$1 == name || $1 == uid { found = 1 } END { exit !found }' "$file" 2> /dev/null; then
				echo "Warning: \"$name\" has no entry in $file for rootless containers, see https://wiki.archlinux.org/title/Podman#Rootless_Podman"
			fi
		done
	done < /etc/passwd
fi

if is_selected ai; then
	echo "Check the GPU with: python -c 'import torch; print(torch.cuda.get_device_name())'"
fi

echo "Done"
